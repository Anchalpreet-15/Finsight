# ---- Required ----
# Groq API key — get from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# JWT secret for signing auth tokens.
# MUST be set in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_before_production

# ---- Optional ----
# Comma-separated list of allowed CORS origins (frontend URLs).
# Leave unset in local dev to allow http://localhost:3001 automatically.
# Example: ALLOWED_ORIGINS=https://finsight.pages.dev,https://finsight.vercel.app
ALLOWED_ORIGINS=

# HuggingFace token (optional — only needed for gated models).
HF_TOKEN=

# Tavily API key for better live web search (fallback is DuckDuckGo).
# Free tier: 1000 requests/month — https://tavily.com
TAVILY_API_KEY=
